{
  "name": "aumevya",
  "version": "0.1.0",
  "description": "Aumevya Yoga — portfolio website + CMS (Next.js 15 + Payload 3)",
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "cross-env NODE_OPTIONS=\"--no-deprecation --no-experimental-webstorage\" next dev",
    "devsafe": "rm -rf .next && cross-env NODE_OPTIONS=\"--no-deprecation --no-experimental-webstorage\" next dev",
    "build": "cross-env NODE_OPTIONS=\"--no-deprecation --no-experimental-webstorage --max-old-space-size=8000\" next build",
    "start": "cross-env NODE_OPTIONS=\"--no-deprecation --no-experimental-webstorage\" next start",
    "lint": "cross-env NODE_OPTIONS=\"--no-deprecation --no-experimental-webstorage\" next lint",
    "typecheck": "cross-env NODE_OPTIONS=\"--no-deprecation --no-experimental-webstorage\" tsc --noEmit",
    "payload": "cross-env NODE_OPTIONS=\"--no-deprecation --no-experimental-webstorage\" payload",
    "generate:types": "cross-env NODE_OPTIONS=\"--no-deprecation --no-experimental-webstorage\" payload generate:types",
    "generate:importmap": "cross-env NODE_OPTIONS=\"--no-deprecation --no-experimental-webstorage\" payload generate:importmap",
    "seed": "cross-env NODE_OPTIONS=\"--no-deprecation --no-experimental-webstorage\" tsx src/seed/seed.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.0",
    "@jhb.software/payload-cloudinary-plugin": "^0.4.0",
    "@payloadcms/db-mongodb": "3.88.0",
    "@payloadcms/next": "3.88.0",
    "@payloadcms/plugin-cloud-storage": "^3.88.0",
    "@payloadcms/richtext-lexical": "3.88.0",
    "@payloadcms/ui": "3.88.0",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cross-env": "^7.0.3",
    "dotenv": "^16.4.7",
    "graphql": "^16.8.1",
    "gsap": "^3.15.0",
    "lenis": "^1.3.26",
    "lucide-react": "^1.31.0",
    "motion": "^13.1.0",
    "next": "15.3.9",
    "nodemailer": "^9.0.5",
    "payload": "3.88.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-hook-form": "^7.85.0",
    "sharp": "0.34.2",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.10.0",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "19.2.0",
    "@types/react-dom": "19.2.0",
    "eslint": "^9.16.0",
    "eslint-config-next": "15.3.9",
    "postcss": "^8.5.26",
    "prettier": "^3.4.2",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=22.4.0"
  }
}
