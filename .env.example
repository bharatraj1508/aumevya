# MongoDB connection string (Atlas or self-hosted)
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/aumevya?retryWrites=true&w=majority

# Payload encryption/JWT secret — generate with: openssl rand -hex 32
PAYLOAD_SECRET=

# Port the app listens on
PORT=3000

# Public site URL (optional; used for admin + email links)
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# --- Email (Gmail SMTP via Payload) ---
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_USER=
# SMTP_PASS=            # Gmail App Password (not your account password)
# EMAIL_FROM=
# ADMIN_NOTIFY_EMAIL=
